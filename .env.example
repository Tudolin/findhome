# ---------------------------------------------------------------------------
# FindHome — copy to .env and edit before the first `docker compose up`.
#   cp .env.example .env
# Compose refuses to start if POSTGRES_PASSWORD or JWT_SECRET are missing.
# ---------------------------------------------------------------------------
 
# --- Database -------------------------------------------------------  -- -  --  --  - 
POSTGRES_USER=findhome        
POSTGRES_DB=findhomep         
# Generate: openssl rand -base64 24  p
POSTGRES_PASSWORD=change-me-before-first-boot      
          
# --- Auth -----------------------------------------------------------  -  -- ---  --
# MUST be at least 32 characters. Generate: openssl rand -base64 48        
# Changing it invalidates every existing session.         
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars         
SESSION_TTL_DAYS=30 ´pç          p 
# Set to true only when a reverse proxy or tunnel terminates HTTPS. On    p  l a  in   
# http://192.168.x.x a Secure cookie is silently dropped and login wi  l l       l  o op .
COOKIE_SECURE=false               
# Flip to false once everyone in the household has an account. Leave it true on
# a server reachable from the internet and you are inviting strangers in.
ALLOW_REGISTRATION=true
MAX_PARTY_MEMBERS=6

# --- Public feed ------------------------------------------------------------
# `/` is browsable without an account: N listings, simple filters, then a sign-up
# gate. Saving, rating, comparing and sharing need somewhere to save to, which is
# what the account is.
#
# The gate is a PRODUCT decision, not a security boundary — everything shown is
# already public on the portal it came from, and the blurred teasers are real
# listings in the HTML. Nothing private can reach that page: it never builds a
# Workspace and its query selects only public columns (web/src/lib/public-feed.ts).
PUBLIC_FEED_LIMIT=20
# In-process cache for the public queries. The page is force-dynamic (it reads
# the session cookie), so without this every anonymous hit is 3 round trips.
PUBLIC_FEED_CACHE_MS=60000

# --- Login hardening --------------------------------------------------------
# bcrypt work factor. Each step doubles the cost of a login AND of cracking a
# stolen hash. 12 is ~250ms per sign-in. Existing hashes are upgraded silently on
# the next successful login, so raising this protects old accounts too.
BCRYPT_ROUNDS=12
# Consecutive wrong passwords before the account locks, and for how long. This
# lives in the database, so it survives a container restart — the in-memory rate
# limiter does not, and `restart: unless-stopped` means restarts happen.
LOGIN_LOCK_THRESHOLD=8
LOGIN_LOCK_MINUTES=15
# How long sign-in attempts stay readable on the Security screen. That list is
# realistically the only way anyone notices someone else has their password.
LOGIN_AUDIT_DAYS=90
          
# --- Networking ---------------------------------------------------- --  --  --- -- 
# 0.0.0.0 exposes the app to the LAN (http://192.168.x.x:3000).       
# Use 127.0.0.1 when Nginx / NPM / Traefik / cloudflared fronts it on the same
# host — see DEPLOY-PUBLICO.md before putting this on the internet.
BIND_ADDRESS=0.0.0.0
WEB_PORT=3000

TZ=America/Sao_Paulo

# --- Scraping ---------------------------------------------------------------
# Standard 5-field cron, evaluated in TZ above. Examples:
#   0 8,20 * * *   08:00 and 20:00 daily (default)
#   0 8 * * *      once a day at 08:00
# Quoted because the value contains spaces — keep the quotes so `setup.sh`,
# `make` and any shell that sources this file read it as one value.
SCRAPE_CRON="0 8,20 * * *"

# Comma-separated. Valid values:
#   ZAP, VIVA_REAL      Grupo ZAP's shared JSON API
#   QUINTO_ANDAR        JSON search API
#   OLX                 rendered page, server-rendered cards
#   CHAVES_NA_MAO       rendered page, schema.org Offer list
#   IMOVELWEB           rendered page, data-qa card markup
#   DEMO                offline synthetic listings, no network calls
#
# Start with DEMO to verify the pipeline end to end, then switch to the portals.
# Before trusting a portal, check it:
#   docker compose exec scraper node dist/doctor.js ZAP,QUINTO_ANDAR
# The doctor probes each endpoint and says whether it is a bot wall, a moved URL
# or a renamed field — the three have different fixes. It writes nothing.
SCRAPE_SOURCES=DEMO

# Run one pass immediately on container start instead of waiting for cron.
SCRAPE_ON_START=true
SCRAPE_MAX_PAGES=2
SCRAPE_PAGE_SIZE=40
# Politeness delay between requests (ms). Do not set this near zero.
SCRAPE_DELAY_MS=1500
# Listings not seen for this many days are hidden from the feed.
SCRAPE_STALE_DAYS=21
# Fallback search target, used ONLY until someone saves preferences in the app.
# These two are a pair and are never applied separately: a saved profile that
# names a city but no state gets no state, rather than inheriting this one.
# Inheriting it would send a search for Curitiba to São Paulo — the portals build
# their URLs from the UF, and they answer 200 with the wrong region rather than
# erroring. Set the state per profile in the app's Preferences screen.
SCRAPE_DEFAULT_CITY="São Paulo"
SCRAPE_DEFAULT_STATE=SP

# --- Photo galleries --------------------------------------------------------
# No portal puts its whole gallery in a search response, and OLX, Chaves na Mão
# and ImovelWeb put exactly one photo there. The rest only exists on the
# listing's own page, so a second pass opens it, reusing the Chromium the scrape
# already launched.
#
# It downloads no images — image requests are answered with a 1x1 stub, which
# costs nothing and still lets lazy carousels load their next slide. So the cost
# is one page load per listing. Bounded per run and stamped, so nothing is
# re-opened forever.
#   make photos                  work through the backlog now
#   make photos N=2000 RESET=5   re-visit everything with fewer than 5 photos
#   make photos-stats            photos per listing, per source
PHOTOS_ENABLED=true
PHOTOS_MAX_PER_RUN=200
# 0 = no gate: every listing gets its page opened once. Set it to N to skip
# listings that already have N photos — faster, but their album stays partial.
PHOTOS_MIN_IMAGES=0
# 0 = store every photo found. There is no reason to throw away photo 16.
PHOTOS_MAX_PER_LISTING=0
PHOTOS_DELAY_MS=900
# How long to let a lazy carousel finish after the page is scrolled.
PHOTOS_SETTLE_MS=1200
PHOTOS_TIMEOUT_MS=30000

# --- Photo mirror (local copies of the image FILES) -------------------------
# Downloads the photos to a Docker volume shared with the app, which fixes two
# things that both look like "the photos broke":
#
#   1. Portals expire their photo URLs. A flat you shortlisted in March is a wall
#      of grey placeholders in May — exactly when you are comparing the three you
#      visited.
#   2. OLX's CDN refuses any Referer that is not olx.com.br. A browser cannot send
#      one; the scraper can, because it fetches server-side. So mirroring is the
#      real fix for those 403s, not a workaround.
#
# Photos of listings you have actually reacted to (rated, shortlisted, pinned,
# booked a visit) are mirrored FIRST and evicted LAST — they are the ones you can
# no longer go and look at on the portal.
#
#   make mirror [N=4000]   work through the backlog now
#   make media-status      how much is stored, and what is safe to purge
PHOTOS_MIRROR=true
# Hard ceiling for the whole mirror. 10k listings x 20 photos x 120 kB is 24 GB,
# so this is a budget, not a suggestion. Over it, the least-valuable copies are
# evicted (see CLEANUP below) rather than the download simply failing.
PHOTOS_MIRROR_MAX_MB=2048
PHOTOS_MIRROR_MAX_PER_RUN=400
PHOTOS_MIRROR_DELAY_MS=120
PHOTOS_MIRROR_MAX_FILE_KB=4096
PHOTOS_MIRROR_MAX_FAILURES=3
PHOTOS_MIRROR_TIMEOUT_MS=20000

# --- Cleanup of listings that came down -------------------------------------
# Ads disappear. `active` already goes false when one stops showing up in search
# results, and the gallery pass now marks it the day its own page 404s — but
# nothing ever deleted the rows or reclaimed their disk.
#
# THE RULE: a listing anyone has touched is NEVER deleted. A rating, a status, a
# pin, a comment, a booked visit — any of those means somebody did work on that
# flat, and "the ad expired" is not a reason to throw their notes away. Those rows
# stay forever, marked "no longer listed", and their photos are the last thing
# evicted under disk pressure.
#
# So this only deletes inactive listings with nothing attached to them.
# 0 disables deletion entirely (the old behaviour: the catalogue grows forever).
CLEANUP_PURGE_DAYS=60
CLEANUP_MAX_PER_RUN=2000

# When an ad closes, its gallery collapses to this many mirrored photos.
#
# An archived listing is a RECORD: what you need is to recognise the flat in your
# shortlist and remember what you thought of it. One cover photo does that. Twenty
# do not do it twenty times better, and at ~120 kB each they are what quietly fills
# the budget with places nobody can rent — crowding out listings that are live.
#
# The others are not deleted from the record: their URLs stay, and the app says
# "mais 11 fotos não puderam ser guardadas" rather than showing 11 broken frames.
# 0 keeps every photo, if disk is not a concern and you want the full album.
CLEANUP_ARCHIVE_KEEP=1
# Waited out first, because portals re-post: an ad back within the week finds its
# gallery intact instead of re-downloading everything.
CLEANUP_ARCHIVE_DAYS=7

# --- Same flat, several ads -------------------------------------------------
# The same apartment is routinely listed on ZAP, OLX and ImovelWeb by two
# different agencies at two different prices. De-duplication by (source, id)
# cannot see that — they are genuinely different ads. This groups them by
# location, size and layout.
#
# Conservative on purpose: a FALSE merge hides a listing permanently and attaches
# your notes to the wrong home, while a missed one is a visible annoyance.
# Listings with no coordinates are never clustered.
DEDUPE_ENABLED=true
DEDUPE_RADIUS_M=60
DEDUPE_AREA_PCT=5
DEDUPE_MAX_PER_RUN=5000

# --- Commute times ----------------------------------------------------------
# "At most 40 minutes to work" — the filter that actually decides where people
# live, and the one no portal offers. OFF by default: it needs a router.
#
#   osrm  self-hosted, free and unlimited:
#           docker run -p 5000:5000 osrm/osrm-backend   (needs a Brazil extract)
#         then COMMUTE_ENDPOINT=http://osrm:5000
#   ors   OpenRouteService — a free key covers ~2.000 requests/day, no infra
#   none  off
#
# The PUBLIC OSRM demo server is donated infrastructure with an explicit
# no-heavy-use policy. Do not point this at it — same rule as Nominatim above.
COMMUTE_PROVIDER=none
COMMUTE_ENDPOINT=
COMMUTE_API_KEY=
COMMUTE_MAX_PER_RUN=200
COMMUTE_DELAY_MS=250

# --- Purchase cost estimate -------------------------------------------------
# The advertised price is never what leaves your account: on a R$ 650.000 flat
# the taxes and fees are around R$ 30.000, and no portal shows them.
#
# Percentages. ITBI is MUNICIPAL and genuinely varies — 2% in São Paulo, 3% in a
# lot of places, and some cities discount a first or financed purchase. Check
# yours; the app labels the result as an estimate either way.
ITBI_PCT=3
DEED_PCT=1
REGISTRY_PCT=0.8
       p
# --- Manual scrape trigger --------------------------- ----- - -----------------
# The scraper exposes a small control API so the app's " S cr  a  pe now" button, and
# `make scrape-now`, can start a run without waiting f o r   c     h it.
SCRAPE_CONTROL_ENABLED=true        
SCRAPE_CONTROL_PORT=8080      
# Shared secret between web and scraper. Generate: open s s  l    rand -hex 24
# Leave empty to skip the check (safe only because the   p or t    stays private).
SCRAPE_CONTROL_TOKEN= 
          
# --- WhatsApp alerts -------------------------------- -       -  -  --------------------- 
# Off by default. Each workspace opts in on the Prefer    e  n   ces    s creen (switch +
# number); these variables only say HOW the message le    a  v      es t  h e server.
#             
#   callmebot  FREE, no infrastructure. Personal-use W  h   a   ts  A pp bridge — message
#              their number once to get an apikey. Rate -lim   i ted  and unofficial,
#              but the fastest way to get alerts on yo     u   r   hone tonight.
#   telegram   FREE and official. Not WhatsApp, but no   c  o st,  n o businesspp
#              account, no message templates and no 24h w       indo w.  If you just want
#              reliable notifications, this is the one tha t  sta ys working.
#   webhook    POST to a URL you control. Use with a sel  f-hoste d gateway you
#              already run (Evolution API, WPPConnect, n 8n  ,   Ho me Assistant).
#              Free to run; note that unofficial Whats Ap     p c lien  ts risk a ban on
#              the number they log in with.     
#   cloud      Meta's official WhatsApp Cloud API. NOT fre e   f or this use: an
#              unsolicited alert is a template message,  wh ic h Meta bills per
#              message in Brazil, and it needs a verifie   d b u s iness account.
#   (empty)    alerts disabled; the Preferences screen   says so.
WHATSAPP_PROVIDER=  
  
# provider=webhook — the body is {to, number, phone, text, m essage, source}, so
# most gateways need no transform. The token is sent as both  `Authorization:c
# Bearer` and `apikey`, because the self-hosted gateways disagree about which.
WHATSAPP_WEBHOOK_URL=
WHATSAPP_WEBHOOK_TOKEN=

# provider=cloud — from your Meta app. IMPORTANT: outside a 24h window opened by
# the user messaging your number first, Meta only delivers *template* messages,
# and an unsolicited alert is exactly that case. Point WHATSAPP_TEMPLATE at an
# approved template whose body has a single {{1}} parameter. Without one, sends
# return 200 and are silently dropped.
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_CLOUD_PHONE_ID=
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=pt_BR
 
# provider=callmebot — message their number once to get this key.
#   1. add +34 644 51 95 23 to your contacts
#   2. send it: I allow callmebot to send me messages
#   3. it replies with your apikey
# Then put YOUR OWN number in the WhatsApp field on the Preferences screen.
WHATSAPP_CALLMEBOT_APIKEY=

# provider=telegram
#   1. message @BotFather on Telegram, /newbot, copy the token
#   2. send your new bot any message
#   3. open https://api.telegram.org/bot<TOKEN>/getUpdates and read
#      result[0].message.chat.id
# Put that chat id in the "WhatsApp number" field on the Preferences screen, or
# set TELEGRAM_CHAT_ID here to override it for every workspace. A negative id is
# a group — handy for a party, so both people get the alert in one place.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Only listings first seen within this many hours are worth a message; older ones
# are marked as seen without being sent. Stops a paused scraper from replaying a
# week of history when it comes back.
ALERT_MAX_AGE_HOURS=48

# --- Map coordinates (geocoding) --------------------------------------------
# QuintoAndar and Chaves na Mão publish lat/lon; OLX and ImovelWeb do not, so
# those listings are missing from the map until their address is resolved.
#
# OFF BY DEFAULT ON PURPOSE. The default endpoint is Nominatim, which is donated
# OpenStreetMap infrastructure: its usage policy allows at most 1 request/second,
# requires a contact address in the User-Agent, and forbids bulk geocoding. The
# settings below keep within that — a handful per run, worked through over days.
# Set GEOCODE_CONTACT to an email you actually read before turning this on.
#
# Running your own Nominatim container? Point GEOCODE_ENDPOINT at it and raise
# the limits freely.
GEOCODE_ENABLED=false
GEOCODE_ENDPOINT=
GEOCODE_MAX_PER_RUN=25
GEOCODE_DELAY_MS=1100
GEOCODE_CONTACT=

# --- Public origin ----------------------------------------------------------
# Only needed when the app is reached through a name the container cannot see
# (reverse proxy, tunnel). Used to build absolute links in the calendar feed and
# WhatsApp messages. Leave empty to derive it from the request.
#   APP_ORIGIN=https://findhome.example.com
APP_ORIGIN=

# --- Portal endpoint overrides ----------------------------------------------
# Only needed when a portal moves its API and `make doctor` reports 404 on every
# known path. Leave empty to use the built-in candidates.
GRUPOZAP_ENDPOINT=
QUINTOANDAR_ENDPOINT=

LOG_LEVEL=info

# --- Resource limits (tune for your box) ------------------------------------
DB_MEMORY_LIMIT=512M
WEB_MEMORY_LIMIT=512M
SCRAPER_MEMORY_LIMIT=1G
SCRAPER_SHM_SIZE=512mb

# --- Seed -------------------------------------------------------------------
# Password given to the demo accounts by `npm run db:seed`.
SEED_PASSWORD=findhome123
